<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Biodata Siswa"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"/>

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="36dp"
                android:background="#C0392B" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/btnPilihFotoMurid"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:background="@android:drawable/edit_text"
                    android:gravity="center"
                    android:text="📸 Klik di Sini untuk Ubah Foto Profil"
                    android:textColor="#C0392B"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Masukkan nama siswa"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nomor Induk Siswa (NIS)"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditNis"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Masukkan NIS"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No. Absen"
                            android:textColor="#212121"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etEditAbsen"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="Absen"
                            android:textColor="#212121"
                            android:textColorHint="#999999"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gender"
                            android:textColor="#212121"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etEditGender"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="L / P"
                            android:textColor="#212121"
                            android:textColorHint="#999999"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal Lahir"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Contoh: 12 Oktober 2008"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nomor WhatsApp"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditWhatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="08xxxxxxxxxx"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram Username"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@username"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perkembangan Bulanan / Catatan Wali Kelas"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditBio"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Tulis catatan perkembangan belajar siswa di sini..."
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quote Motivasi Siswa"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEditQuote"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Quote motivasi"
                    android:textColor="#212121"
                    android:textColorHint="#999999"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/btnSaveData"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/login_button_bg"
            android:gravity="center"
            android:text="Simpan Perubahan"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/btnCancelEdit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:text="Batal &amp; Kembali"
            android:textColor="#777777"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>