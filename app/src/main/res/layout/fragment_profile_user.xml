<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- ===== ACCENT BAR — warnanya ganti via kode sesuai role ===== -->
        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/primary_red" />

        <!-- ===== HEADER SECTION ===== -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="40dp"
            android:background="@drawable/profile_header_bg">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <View
                    android:id="@+id/viewAvatarRing"
                    android:layout_width="122dp"
                    android:layout_height="122dp"
                    android:layout_gravity="center"
                    android:background="@drawable/profile_ring_outer" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMyProfilePic"
                    android:layout_width="106dp"
                    android:layout_height="106dp"
                    android:layout_gravity="center"
                    android:padding="4dp"
                    android:src="@drawable/ic_profile"
                    app:strokeColor="@color/primary_red"
                    app:strokeWidth="3dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                    app:tint="@color/primary_red" />

                <!-- Initials overlay (tampil jika tidak ada foto) -->
                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="106dp"
                    android:layout_height="106dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_red"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Nama -->
            <TextView
                android:id="@+id/tvMyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginHorizontal="24dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Biebha Arya Wirawan"
                android:textColor="#1A1D20"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tvMyRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/role_selected_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp"
                android:text="Wali Kelas"
                android:textColor="@color/primary_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- ===== STATS CARD (floating overlap) ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStat1Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32"
                        android:textColor="@color/primary_red"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStat1Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siswa"
                        android:textColor="#A4B0BE"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:layout_gravity="center_vertical" android:background="#F1F2F6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStat2Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XI"
                        android:textColor="@color/primary_red"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStat2Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tingkat"
                        android:textColor="#A4B0BE"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:layout_gravity="center_vertical" android:background="#F1F2F6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStat3Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PPLG"
                        android:textColor="@color/primary_red"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStat3Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jurusan"
                        android:textColor="#A4B0BE"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== INFO CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EAEAEA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvInfoSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMASI AKUN"
                    android:textColor="@color/primary_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp" />

                <!-- Row Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="8dp">

                    <FrameLayout
                        android:id="@+id/fvIconEmail"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/icon_circle_bg">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="@color/primary_red" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontak Akun"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMyEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="biebha@gmail.com"
                            android:textColor="#2F3542"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F1F2F6" />

                <!-- Row Info 2 (dinamis: versi app / status kehadiran / level akses) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="8dp">

                    <FrameLayout
                        android:id="@+id/fvIconInfo2"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/icon_circle_bg">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/primary_red" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvInfo2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Versi Aplikasi"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvInfo2Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="v1.0.2 – XI PPLG 4"
                            android:textColor="#2F3542"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInfo2Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terbaru"
                        android:textColor="#27AE60"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_success_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== ACADEMIC GRID — hanya tampil untuk role SISWA ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAcademic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EAEAEA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATA AKADEMIK"
                    android:textColor="#639922"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <!-- Rata-rata Nilai -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:background="@drawable/acad_card_bg"
                        android:padding="12dp"
                        android:layout_margin="4dp">
                        <TextView
                            android:id="@+id/tvAvgNilai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="87"
                            android:textColor="#639922"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rata-rata Nilai"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Tidak Hadir -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:background="@drawable/acad_card_bg"
                        android:padding="12dp"
                        android:layout_margin="4dp">
                        <TextView
                            android:id="@+id/tvTidakHadir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="#639922"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak Hadir"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Predikat -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:background="@drawable/acad_card_bg"
                        android:padding="12dp"
                        android:layout_margin="4dp">
                        <TextView
                            android:id="@+id/tvPredikat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            android:textColor="#639922"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predikat"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Pelanggaran -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:background="@drawable/acad_card_bg"
                        android:padding="12dp"
                        android:layout_margin="4dp">
                        <TextView
                            android:id="@+id/tvPelanggaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#639922"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pelanggaran"
                            android:textColor="#A4B0BE"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== GUEST NOTE — hanya tampil untuk role UMUM/TAMU ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGuestNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E6F1FB"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="top">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#378ADD"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Akun tamu hanya bisa melihat informasi umum. Hubungi admin sekolah untuk mendapatkan akses penuh."
                    android:textColor="#0C447C"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- ===== LOGOUT BUTTON ===== -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/role_unselected_bg"
            android:text="Keluar dari Akun"
            android:textAllCaps="false"
            android:textColor="@color/primary_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

    </LinearLayout>
</ScrollView>